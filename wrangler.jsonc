{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appzed-cost-optimizer",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "GOV"
    }
  ],
  "triggers": {
    "crons": [
      "42 7 * * 1"
    ]
  }
}
